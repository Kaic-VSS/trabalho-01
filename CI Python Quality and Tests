# Define que o robô vai agir sempre que você fizer um push ou abrir um Pull Request na branch main
on:
  push:
    branches: [ Trab_Final ]
  pull_request:
    branches: [ Trab_Final ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Copiar código do repositório
      uses: actions/checkout@v4

    - name: Configurar o Python
      uses: actions/setup-python@v5
      with:
        python-version: "3.11"

    - name: Instalar dependências (pytest, flake8, black)
      run: |
        python -m pip install --upgrade pip
        pip install pytest flake8 black

    - name: Verificar estilo de código com Flake8
      run: |
        # Roda o flake8 para checar o padrão (ignorando erros críticos de linha se necessário, ou ajustando o código)
        flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
        flake8 . --count --exit-zero --max-complexity=10 --max-line-length=79 --statistics

    - name: Rodar testes automatizados com Pytest
      run: |
        pytest
